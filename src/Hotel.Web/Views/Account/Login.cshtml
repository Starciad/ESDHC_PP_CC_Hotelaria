@model Hotel.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/login.css" />
}

<main class="login-container">

    <section class="login-left">
        <div class="login-text">
            <h1>Luxury Stay Experience</h1>
            <p>Enjoy unforgettable moments with Paradise View Hotel.</p>
        </div>
    </section>

    <section class="login-right">
        <a asp-controller="Home" asp-action="Index" class="back-button">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <div class="login-box">
            <div class="login-logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="login-subtitle">
                Paradise View
            </span>

            <h2>Welcome Back</h2>
            <p>Login to continue your experience.</p>

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="input-group">
                    <label asp-for="Email"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>
                        <input asp-for="Email" placeholder="Digite seu e-mail" />
                    </div>

                    <span asp-validation-for="Email"class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Password"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" placeholder="Digite sua senha" />
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="login-options">
                    <label><input asp-for="RememberMe" /> Lembrar-me</label>
                    <a href="#">Esqueceu a senha?</a>
                </div>

                <button type="submit"class="btn-login">Login</button>
            </form>

            <div class="register-text">Não possui conta? <a asp-controller="Account" asp-action="Register">Criar conta</a></div>
        </div>
    </section>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
