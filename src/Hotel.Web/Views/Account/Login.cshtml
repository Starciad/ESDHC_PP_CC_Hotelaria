@model Hotel.Web.ViewModels.LoginViewModel

<h2>Login</h2>

<form asp-action="Login" method="post">
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div>
        <input asp-for="RememberMe" />
        <label asp-for="RememberMe"></label>
    </div>

    <button type="submit">Entrar</button>
</form>

<main class="login-page">

    <section class="login-left">

        <div class="login-text">
            <h1>Luxury Stay Experience</h1>

            <p>
                Enjoy unforgettable moments with Paradise View Hotel.
            </p>
        </div>

    </section>

    <section class="login-right">
        <a href="index.html" class="back-button">
            <i class="fa-solid fa-arrow-left"></i>
            Back
        </a>


        <div class="login-box">

            <div class="login-logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="login-subtitle">
                Paradise View
            </span>

            <h2>Welcome Back</h2>

            <p>
                Login to continue your experience.
            </p>

            <form onsubmit="event.preventDefault(); alert('Login realizado!')">

                <div class="input-group">

                    <label>E-mail</label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>

                        <input type="email"
                               placeholder="Digite seu e-mail"
                               required>
                    </div>

                </div>

                <div class="input-group">

                    <label>Senha</label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>

                        <input type="password"
                               placeholder="Digite sua senha"
                               required>
                    </div>

                </div>

                <div class="login-options">

                    <label>
                        <input type="checkbox">
                        Lembrar-me
                    </label>

                    <a href="#">
                        Esqueceu a senha?
                    </a>

                </div>

                <button class="btn-login">
                    Login
                </button>

            </form>

            <div class="register-text">
                Não possui conta?
                <a href="register.html">Criar conta</a>
            </div>

        </div>

    </section>

</main>