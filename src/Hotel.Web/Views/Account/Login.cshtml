@model Hotel.Web.ViewModels.LoginViewModel

@{
    // Essa página é dedicada ao processo de login dos
    // usuários, oferecendo uma interface elegante e
    // moderna. O layout é dividido em duas seções: a
    // esquerda apresenta uma imagem de fundo com um
    // texto de boas-vindas, enquanto a direita contém o
    // formulário de login. O design é pensado para
    // proporcionar uma experiência agradável e intuitiva,
    // refletindo a proposta de luxo do hotel.

    ViewData["Title"] = "Inscreva-se";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/login.css" />
}

<main class="login-container">
    <!-- LEFT -->
    <section class="login-left">
        <div class="login-text">
            <h1>Experiência de Estadia Luxuosa</h1>
            <p>Aproveite momentos inesquecíveis com o nosso hotel.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="login-right">
        <a asp-controller="Home" asp-action="Index" class="back-button"><i class="fa-solid fa-arrow-left"></i> Voltar</a>

        <div class="login-box">
            <div class="login-logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="login-subtitle">
                Vista do Paraíso
            </span>

            <h2>Bem-vindo(a) de Volta!</h2>
            <p>Faça o cadastro para continuar com sua experiência.</p>

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="input-group">
                    <label asp-for="Email"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>
                        <input asp-for="Email" placeholder="Digite seu e-mail" />
                    </div>

                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Password"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" placeholder="Digite sua senha" />
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="login-options">
                    <label><input asp-for="RememberMe" /> Lembrar-me</label>
                    <a href="#">Esqueceu a senha?</a>
                </div>

                <button type="submit" class="btn-login">Cadastro</button>
            </form>

            <div class="register-text">Não possui conta? <a asp-controller="Account" asp-action="Register">Criar Conta</a></div>
        </div>
    </section>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
