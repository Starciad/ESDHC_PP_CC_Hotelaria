@model Hotel.Web.ViewModels.RegisterViewModel

<h2>Registro</h2>

<form asp-action="Register" method="post">
    <div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit">Registrar</button>
</form>

<main class="register-page">

    <section class="register-left">

        <div class="register-text">

            <h1>
                Your Luxury Journey Starts Here
            </h1>

            <p>
                Create your account and discover unforgettable experiences with Paradise View Hotel.
            </p>

        </div>

    </section>

    <section class="register-right">


        <a href="index.html" class="back-button">
            <i class="fa-solid fa-arrow-left"></i>
            Back
        </a>

        <div class="register-box">

            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">
                Paradise View
            </span>

            <h2>Criar Conta</h2>

            <p>
                Preencha os dados abaixo para começar.
            </p>

            <form onsubmit="event.preventDefault(); alert('Conta criada com sucesso!')">

                <div class="input-group">

                    <label>Nome completo</label>

                    <div class="input-box">
                        <i class="fa-solid fa-user"></i>

                        <input type="text"
                               placeholder="Digite seu nome"
                               required>
                    </div>

                </div>

                <div class="input-group">

                    <label>E-mail</label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>

                        <input type="email"
                               placeholder="Digite seu e-mail"
                               required>
                    </div>

                </div>

                <div class="input-group">

                    <label>Senha</label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>

                        <input type="password"
                               placeholder="Crie uma senha"
                               required>
                    </div>

                </div>

                <div class="input-group">

                    <label>Confirmar senha</label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>

                        <input type="password"
                               placeholder="Confirme sua senha"
                               required>
                    </div>

                </div>

                <div class="terms">

                    <input type="checkbox" required>

                    <span>
                        Eu aceito os
                        <a href="#">termos e condições</a>
                    </span>

                </div>

                <button class="btn-register">
                    Criar Conta
                </button>

            </form>

            <div class="login-link">

                Já possui conta?
                <a href="login.html">
                    Fazer login
                </a>

            </div>

        </div>

    </section>

</main>