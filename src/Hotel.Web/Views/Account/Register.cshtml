@model Hotel.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/register.css" />
}

<main class="register-container">
    <!-- LEFT -->
    <section class="register-left">
        <div class="register-text">
            <h1>Your Luxury Journey Starts Here</h1>
            <p>Create your account and discover unforgettable experiences with Paradise View Hotel.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="register-right">
        <a asp-controller="Home" asp-action="Index" class="back-button">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <div class="register-box">
            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">Paradise View</span>

            <h2>Criar Conta</h2>
            <p>Preencha os dados abaixo para começar.</p>

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="input-group">
                    <label asp-for="FullName"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-user"></i>
                        <input asp-for="FullName" placeholder="Digite seu nome" />
                    </div>

                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Email"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>
                        <input asp-for="Email" placeholder="Digite seu e-mail" />
                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="input-group">
                    <label asp-for="Password"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" placeholder="Crie uma senha" />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>
                </div>

                <div class="input-group">
                    <label asp-for="ConfirmPassword"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="ConfirmPassword" placeholder="Confirme sua senha" />
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>
                </div>

                <div class="terms">
                    <input type="checkbox" required />
                    <span>Eu aceito os <a href="#">termos e condições</a></span>
                </div>

                <button type="submit" class="btn-register">Criar Conta</button>
            </form>

            <div class="login-link">Já possui conta? <a asp-controller="Account" asp-action="Login">Fazer login</a></div>
        </div>
    </section>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
