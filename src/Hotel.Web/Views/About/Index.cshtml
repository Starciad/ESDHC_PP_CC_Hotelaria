@{
    ViewData["Title"] = "About Us";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/about.css" />
}

<main class="about-container">
    <!-- LEFT -->
    <section class="about-left">
        <div class="about-overlay">
            <h1>Luxo Além das Expectativas</h1>
            <p>O hotel combina elegância, conforto e experiências inesquecíveis em um único lugar.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="about-right">
        <a asp-controller="Home" asp-action="Index" class="back-button"><i class="fa-solid fa-arrow-left"></i> Voltar</a>

        <div class="about-box">
            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">Vista do Paraíso</span>

            <h2>Sobre Nós</h2>
            <p class="about-description">O hotel foi criado para prover momentos sofisticados inesquecíveis com conforto e um serviço exceptional. Todos os detalhes foram cuidadosamente planejados para transformar sua estadia numa experiência luxosa.</p>

            <!-- CARDS -->
            <div class="about-cards">
                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-hotel"></i></div>
                    <h3>Quartos de Luxo</h3>
                    <p>Suites premiums com design pensado para seu conforto e elegância.</p>
                </div>

                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-utensils"></i></div>
                    <h3>Jantar Extraordinário</h3>
                    <p>Aproveite experiências culinárias exclusivas feitas chefes do mundo inteiro.</p>
                </div>

                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-spa"></i></div>
                    <h3>Spa e Bem-Estar</h3>
                    <p>Relaxe e se renove em nosso serviço de spa luxuoso.</p>
                </div>

                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-water-ladder"></i></div>
                    <h3>Piscina de Borda Infinita</h3>
                    <p>Piscina deslumbrante com vista panorâmica de tirar o folego.</p>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats">
                <div class="stat-item">
                    <h3>15+</h3>
                    <span>Anos de Experiência</span>
                </div>

                <div class="stat-item">
                    <h3>5K+</h3>
                    <span>Clientes Satisfeitos</span>
                </div>

                <div class="stat-item">
                    <h3>24/7</h3>
                    <span>Atendimento Premium</span>
                </div>
            </div>

            <a asp-controller="Contact" asp-action="Index">Contate-Nos</a>
        </div>
    </section>
</main>