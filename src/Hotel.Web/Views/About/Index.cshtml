@{
    ViewData["Title"] = "About Us";
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/about.css" />
}

<main class="about-container">
    <!-- LEFT -->
    <section class="about-left">
        <div class="about-overlay">
            <h1>Luxury Beyond Expectations</h1>
            <p>Paradise View Hotel combines elegance, comfort and unforgettable experiences in one destination.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="about-right">
        <a href="index.html" class="back-button"><i class="fa-solid fa-arrow-left"></i> Back</a>

        <div class="about-box">
            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">Paradise View</span>

            <h2>About Us</h2>

            <p class="about-description">
                Paradise View Hotel was created to provide unforgettable moments with sophistication, comfort and exceptional service. Every detail is carefully designed to transform your stay into a luxurious experience.
            </p>

            <!-- CARDS -->
            <div class="about-cards">
                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-hotel"></i></div>
                    <h3>Luxury Rooms</h3>
                    <p>Premium suites designed for comfort and elegance.</p>
                </div>

                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-utensils"></i></div>
                    <h3>Fine Dining</h3>
                    <p>Enjoy exclusive culinary experiences from world-class chefs.</p>
                </div>

                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-spa"></i></div>
                    <h3>Spa & Wellness</h3>
                    <p>Relax and renew yourself with our luxury spa services.</p>
                </div>

                <div class="card">
                    <div class="card-icon"><i class="fa-solid fa-water-ladder"></i></div>
                    <h3>Infinity Pool</h3>
                    <p>Stunning pools with breathtaking panoramic views.</p>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats">
                <div class="stat-item">
                    <h3>15+</h3>
                    <span>Anos de experiência</span>
                </div>

                <div class="stat-item">
                    <h3>5K+</h3>
                    <span>Clientes satisfeitos</span>
                </div>

                <div class="stat-item">
                    <h3>24/7</h3>
                    <span>Atendimento premium</span>
                </div>
            </div>

            <a href="contact.html" class="btn-about">Contact Us</a>
        </div>
    </section>
</main>