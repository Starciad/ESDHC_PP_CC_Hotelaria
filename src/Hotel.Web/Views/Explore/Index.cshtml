@{
    ViewData["Title"] = "Explore";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/explore.css" />
}

<main class="explore-container">
    <!-- HEADER -->
    <section class="explore-header">
        <a asp-controller="Home" asp-action="Index" class="back-button">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <div class="header-content">
            <span>Paradise View</span>
            
            <h1>Explore Luxury Experiences</h1>
            <p>Discover exclusive experiences, premium accommodations and unforgettable moments designed for your comfort.</p>
        </div>
    </section>

    <!-- CONTENT -->
    <section class="explore-content">
        <div class="section-title">
            <h2>Explore Our Experiences</h2>
            <p>Paradise View offers luxury services and breathtaking experiences for every guest.</p>
        </div>

        <!-- FEATURES -->
        <div class="features">

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-spa"></i>
                </div>

                <h3>Spa & Wellness</h3>

                <p>
                    Relax with premium spa treatments and wellness experiences.
                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <h3>Fitness Center</h3>

                <p>
                    Modern gym equipment available 24 hours for all guests.
                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-water-ladder"></i>
                </div>

                <h3>Private Pool</h3>

                <p>
                    Exclusive private pool areas with luxury service and comfort.
                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-champagne-glasses"></i>
                </div>

                <h3>Luxury Events</h3>

                <p>
                    Celebrate unforgettable moments with elegant event experiences.
                </p>

            </div>

        </div>

    </section>

</main>
