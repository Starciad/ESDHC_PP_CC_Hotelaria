@{
    ViewData["Title"] = "Explore";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/explore.css" />
}

<main class="explore-container">
    <!-- HEADER -->
    <section class="explore-header">
        <a asp-controller="Home" asp-action="Index" class="back-button">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <div class="header-content">
            <span>Paradise View</span>
            
            <h1>Explore Luxury Experiences</h1>
            <p>Discover exclusive experiences, premium accommodations and unforgettable moments designed for your comfort.</p>
        </div>
    </section>

    <!-- CONTENT -->

    <section class="explore-content">
        <div class="section-title">
            <h2>Explore Our Experiences</h2>
            <p>Paradise View offers luxury services and breathtaking experiences for every guest.</p>
        </div>

        <!-- CARDS -->
        <div class="explore-grid">
            <div class="explore-card">
                <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80">

                <div class="card-content">
                    <h3>Luxury Rooms</h3>

                    <p>Elegant suites with modern design, premium comfort and panoramic views.</p>

                    <div class="card-info">
                        <span>From $299</span>

                        <a href="#" class="btn-explore">
                            Explore
                        </a>
                    </div>
                </div>
            </div>

            <div class="explore-card">

                <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80">

                <div class="card-content">

                    <h3>Infinity Pool</h3>

                    <p>
                        Relax in our luxurious infinity pool with breathtaking sunset views.
                    </p>

                    <div class="card-info">

                        <span>Premium Access</span>

                        <a href="#" class="btn-explore">
                            Explore
                        </a>

                    </div>

                </div>

            </div>

            <div class="explore-card">

                <img src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=1200&q=80">

                <div class="card-content">

                    <h3>Fine Dining</h3>

                    <p>
                        Experience world-class cuisine prepared by award-winning chefs.
                    </p>

                    <div class="card-info">

                        <span>Exclusive Menu</span>

                        <a href="#" class="btn-explore">
                            Explore
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- FEATURES -->

        <div class="features">

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-spa"></i>
                </div>

                <h3>Spa & Wellness</h3>

                <p>
                    Relax with premium spa treatments and wellness experiences.
                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <h3>Fitness Center</h3>

                <p>
                    Modern gym equipment available 24 hours for all guests.
                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-water-ladder"></i>
                </div>

                <h3>Private Pool</h3>

                <p>
                    Exclusive private pool areas with luxury service and comfort.
                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-champagne-glasses"></i>
                </div>

                <h3>Luxury Events</h3>

                <p>
                    Celebrate unforgettable moments with elegant event experiences.
                </p>

            </div>

        </div>

    </section>

</main>
