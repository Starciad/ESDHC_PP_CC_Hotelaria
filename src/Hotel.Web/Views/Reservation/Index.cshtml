@{
    ViewData["Title"] = "Reservation";
    ViewData["HasHeader"] = false;
}

@section Styles {

}

<main class="reservation-page">
    <!-- LEFT -->
    <section class="reservation-left">
        <div class="left-content">
            <span>Paradise View</span>

            <h1>Your Luxury Stay Starts Here</h1>
            <p>Reserve your room now and enjoy unforgettable experiences, premium comfort and exceptional hospitality.</p>
        </div>

    </section>

    <!-- RIGHT -->
    <section class="reservation-right">
        <a asp-controller="Rooms" asp-action="Index" class="back-button">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <div class="reservation-box">
            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">Reservation</span>

            <h2>Book Your Room</h2>
            <p>Fill in your details to complete your reservation at Paradise View Hotel.</p>

            <!-- FORM -->
            <form class="reservation-form" onsubmit="event.preventDefault(); alert('Reserva realizada com sucesso!')">
                <div class="double-input">
                    <div class="input-group">
                        <label>Check-in</label>

                        <div class="input-box">
                            <i class="fa-solid fa-calendar"></i>
                            <input type="date" required>
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Check-out</label>
                        
                        <div class="input-box">
                            <i class="fa-solid fa-calendar"></i>
                            <input type="date" required>
                        </div>
                    </div>
                </div>

                <div class="double-input">
                    <div class="input-group">
                        <label>Guests</label>

                        <div class="input-box">
                            <i class="fa-solid fa-user-group"></i>
                            <input type="number" min="1" max="10" value="1" required>
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Room Type</label>

                        <div class="input-box">
                            <i class="fa-solid fa-bed"></i>

                            <select required>
                                <option>Deluxe Suite</option>
                                <option>Executive Room</option>
                                <option>Presidential Suite</option>
                            </select>
                        </div>
                    </div>
                </div>

                <button class="btn-reserve">Confirm Reservation</button>
            </form>
        </div>
    </section>
</main>
