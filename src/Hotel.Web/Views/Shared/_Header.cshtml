@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{

}

<header class="navbar">
    <div class="logo">
        <span class="logo-icon">▲</span>
        <span class="logo-text">PV</span>
    </div>

    <nav class="nav-links">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <a asp-controller="Rooms" asp-action="Index">Quartos</a>
        <a asp-controller="About" asp-action="Index">Sobre</a>
        <a asp-controller="Contact" asp-action="Index">Contato</a>
    </nav>

    <div class="nav-buttons">
        <!-- If If the user is logged into an account, the logout button will appear. Otherwise, the login button will appear. -->
        @if (SignInManager.IsSignedIn(User))
        {
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-nav">Entrar</a>
        }
    </div>
</header>
