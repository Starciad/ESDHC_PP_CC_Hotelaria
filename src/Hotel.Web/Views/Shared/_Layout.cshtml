<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Paradise View</title>

    <!-- STYLES -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Plus+Jakarta+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/styles/reset.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/general.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/palette.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/components/header.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- HAS HEADER? -->
    @if (ViewData["HasHeader"] != null && (bool)ViewData["HasHeader"] == true)
    {
        <partial name="_Header" />
    }

    <div>
        @RenderBody()
    </div>

    <footer>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
