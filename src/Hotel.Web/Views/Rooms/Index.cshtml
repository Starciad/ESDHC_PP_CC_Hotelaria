@model Hotel.Web.ViewModels.RoomsIndexViewModel

@{
    // Esta página é dedicada à exibição dos quartos disponíveis para reserva,
    // oferecendo uma interface elegante e moderna. O layout inclui um cabeçalho
    // com um título e uma breve descrição do hotel, seguido por uma seção de
    // filtros que permite aos usuários refinar sua busca por quartos com base
    // em critérios como preço, capacidade e comodidades. Abaixo dos filtros,
    // os quartos são apresentados em um formato de grade, cada um exibindo uma
    // imagem, título, descrição, comodidades e preço. A página também inclui uma
    // funcionalidade de paginação para facilitar a navegação entre os resultados,
    // garantindo uma experiência de usuário fluida e agradável. O design é pensado
    // para refletir a proposta de luxo do hotel, com uma estética sofisticada e moderna.
    
    ViewData["Title"] = "Quartos";
    ViewData["HasHeader"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/rooms.css" />
}

<main class="rooms-container">
    <!-- PAGE HEADER -->
    <section class="page-header">
        <span class="subtitle">Vista do Paraíso</span>

        <h1>Um hotel para cada momento rico da vida</h1>
        <p>Todo momento parece como se fosse a primeira vez no paraíso.</p>
    </section>

    <!-- ROOMS -->
    <section class="rooms-section">
        <div class="rooms-search">
            <form method="get" class="filters-form">
                <div class="input-group">
                    <label asp-for="Filter.Search"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input asp-for="Filter.Search" type="text" placeholder="Procurar quartos" />
                    </div>
                </div>
                
                <div class="input-group">
                    <label asp-for="Filter.MinPrice"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-dollar-sign"></i>
                        <input asp-for="Filter.MinPrice" type="number" placeholder="Min price" />
                    </div>
                </div>

                <div class="input-group">
                    <label asp-for="Filter.MaxPrice"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-dollar-sign"></i>
                        <input asp-for="Filter.MaxPrice" type="number" placeholder="Max price" />
                    </div>
                </div>

                <div class="input-group">
                    <label asp-for="Filter.Capacity"></label>

                    <div class="input-box">
                        <i class="fa-solid fa-users"></i>
                        <input asp-for="Filter.Capacity" type="number" placeholder="Guests" />
                    </div>
                </div>

                <button type="submit" class="btn-filter">Filter</button>
            </form>
        </div>

        <div class="rooms-grid">
            @foreach (Room room in Model.Rooms)
            {
                <div class="room-card">
                    <img src="@room.ImageUrl" alt="@room.Title" class="room-image">
                    <div class="room-content">
                        <h2>@room.Title</h2>
                        <p>@room.Description</p>

                        <div class="amenities">
                            <span class="amenity-tag">@room.Capacity Adultos</span>

                            @if (room.HasWifi)
                            {
                                <span class="amenity-tag">Wi-Fi Gratis</span>
                            }

                            @if (room.HasBalcony)
                            {
                                <span class="amenity-tag">Balcão</span>
                            }

                            @if (room.HasPool)
                            {
                                <span class="amenity-tag">Piscina</span>
                            }

                        </div>

                        <div class="card-footer">
                            <div class="price">$ @room.Price.ToString("F2")<span>/ noite</span></div>
                            <a asp-controller="Reservations"
                               asp-action="Create"
                               asp-route-roomId="@room.Id"
                               class="btn-book">
                                Reserve Agora
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-Page="@i"
                   asp-route-Search="@Model.Filter.Search"
                   asp-route-MinPrice="@Model.Filter.MinPrice"
                   asp-route-MaxPrice="@Model.Filter.MaxPrice"
                   asp-route-Capacity="@Model.Filter.Capacity"
                   class="page-button @(i == Model.CurrentPage ? "active" : "")">
                    @i
                </a>
            }
        </div>
    </section>
</main>