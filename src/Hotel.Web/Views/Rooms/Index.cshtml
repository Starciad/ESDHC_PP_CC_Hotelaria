@{
    ViewData["Title"] = "Rooms";
    ViewData["HasHeader"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/rooms.css" />
}

<main class="rooms-container">
    <!-- PAGE HEADER -->

    <section class="page-header">

        <span class="subtitle">
            Paradise View
        </span>

        <h1>
            Hotel for every moment rich in emotion
        </h1>

        <p>
            Every moment feels like the first time in Paradise View.
        </p>

    </section>

    <!-- ROOMS -->

    <section class="rooms-section">

        <div class="rooms-grid">

            <!-- ROOM 1 -->

            <div class="room-card">

                <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1000&q=80"
                     alt="Room"
                     class="room-image">

                <div class="room-content">

                    <h2>Standard Ocean View</h2>

                    <p>
                        Wake up to the relaxing sound of the ocean with elegant interiors and premium comfort.
                    </p>

                    <div class="amenities">

                        <span class="amenity-tag">2 Adults</span>

                        <span class="amenity-tag">Free Wi-Fi</span>

                        <span class="amenity-tag">Balcony</span>

                    </div>

                    <div class="card-footer">

                        <div class="price">
                            $1800 <span>/ night</span>
                        </div>

                        <a href="#" class="btn-book">
                            Book Now
                        </a>

                    </div>

                </div>

            </div>

            <!-- ROOM 2 -->

            <div class="room-card">

                <img src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1000&q=80"
                     alt="Room"
                     class="room-image">

                <div class="room-content">

                    <h2>Deluxe Beachfront</h2>

                    <p>
                        Spacious beachfront room with exclusive access and breathtaking sunset views.
                    </p>

                    <div class="amenities">

                        <span class="amenity-tag">3 Adults</span>

                        <span class="amenity-tag">King Bed</span>

                        <span class="amenity-tag">Beach Access</span>

                    </div>

                    <div class="card-footer">

                        <div class="price">
                            $2800 <span>/ night</span>
                        </div>

                        <a href="#" class="btn-book">
                            Book Now
                        </a>

                    </div>

                </div>

            </div>

            <!-- ROOM 3 -->

            <div class="room-card">

                <img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=1000&q=80"
                     alt="Room"
                     class="room-image">

                <div class="room-content">

                    <h2>Premium Pool Suite</h2>

                    <p>
                        Ultimate luxury with a private pool, panoramic terrace and premium room service.
                    </p>

                    <div class="amenities">

                        <span class="amenity-tag">Private Pool</span>

                        <span class="amenity-tag">Room Service</span>

                        <span class="amenity-tag">Panoramic View</span>

                    </div>

                    <div class="card-footer">

                        <div class="price">
                            $5500 <span>/ night</span>
                        </div>

                        <a href="#" class="btn-book">
                            Book Now
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>
</main>