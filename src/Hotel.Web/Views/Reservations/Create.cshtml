@model Hotel.Web.ViewModels.ReservationCreateViewModel

@{
    // Página dedicada à criação de reservas, oferecendo uma interface elegante e moderna.
    // Por meio de um formulário intuitivo, os usuários podem selecionar as datas de check-in
    // e check-out, além de adicionar dependentes ou hóspedes adicionais, respeitando a
    // capacidade do quarto escolhido.
    
    ViewData["Title"] = "Reserve um Quarto";
    ViewData["HasHeader"] = true;

    int maxDependents = Math.Max(0, Model.RoomCapacity - 1);
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/reservation.css" />
}

<template id="dependent-template">
    <div class="dependent-card" data-dependent-item>
        <div class="dependent-header">
            <h5>Convidado</h5>
            <button type="button" class="btn btn-danger btn-remove-dependent">Remover</button>
        </div>

        <div class="input-group">
            <label>Nome</label>

            <div class="input-box">
                <i class="fa-solid fa-user"></i>
                <input type="text" name="Dependents[__index__].Name" placeholder="Nome do dependente" />
            </div>
        </div>

        <div class="input-group">
            <label>Data de nascimento</label>

            <div class="input-box">
                <i class="fa-solid fa-calendar-days"></i>
                <input type="date" name="Dependents[__index__].BirthdayDate" />
            </div>
        </div>
    </div>
</template>

<main class="reservation-container">
    <!-- LEFT -->
    <section class="reservation-left">
        <div class="left-content">
            <span>Vista do Paraíso</span>

            <h1>Sua estadia de luxo começa aqui</h1>
            <p>Reserve seu quarto agora e aproveite experiências inesquecíveis, conforto premium e hospitalidade excepcional.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="reservation-right">
        <div class="reservation-box">
            <article class="reservation-room-card">
                <img src="@Model.RoomImageUrl" alt="@Model.RoomTitle" class="reservation-room-image" />
                <div class="reservation-room-info">
                    <h2>@Model.RoomTitle</h2>
                    <p>@Model.RoomDescription</p>

                    <div class="room-meta">
                            <span>@Model.RoomCapacity hóspedes</span>
                            <span>$@Model.RoomPrice por noite</span>
                    </div>
                </div>
            </article>

            <!-- FORM -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form asp-controller="Reservations" asp-action="Create" method="post" class="reservation-form">
                @Html.AntiForgeryToken()

                <input asp-for="RoomId" type="hidden" />

                <div class="double-input">
                    <div class="input-group">
                        <label asp-for="PretendedCheckInDate"></label>

                        <div class="input-box">
                            <i class="fa-solid fa-calendar-days"></i>
                            <input asp-for="PretendedCheckInDate" type="date" />
                        </div>

                        <span asp-validation-for="PretendedCheckInDate" class="text-danger"></span>
                    </div>

                    <div class="input-group">
                        <label asp-for="PretendedCheckOutDate"></label>

                        <div class="input-box">
                            <i class="fa-solid fa-calendar-days"></i>
                            <input asp-for="PretendedCheckOutDate" type="date" />
                        </div>

                        <span asp-validation-for="PretendedCheckOutDate" class="text-danger"></span>
                    </div>
                </div>

                <div>
                    <h3>Informações do Hóspede</h3>

                    <div class="dependents-header">
                        <h4>Convidados / hóspedes</h4>
                        <p>Máximo de hóspedes adicionais: @maxDependents</p>
                        <p>Vagas restantes: <span id="remaining-guests">@maxDependents</span></p>
                    </div>

                    <div id="dependents-container" data-max-dependents="@maxDependents"></div>

                    <button type="button" id="add-dependent" class="btn btn-primary">
                        <i class="fa-solid fa-user-plus"></i> Adicionar convidado
                    </button>
                </div>

                <button class="btn-reserve"><i class="fa-solid fa-check"></i> Confirmar Reserva</button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/scripts/reservations.js"></script>
}
