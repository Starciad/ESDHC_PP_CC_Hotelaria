@{
    // Essa página oferece uma visão geral do hotel
    // para os visitantes, destacando seus serviços e experiências
    // exclusivos. O layout é dividido em seções distintas, cada uma
    // apresentando diferentes aspectos do hotel, como a seção de
    // destaque, as instalações e as experiências oferecidas. O design
    // é elegante e moderno, refletindo a proposta de luxo do hotel.

    ViewData["Title"] = "Inicio";
    ViewData["HasHeader"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/home.css" />
    <link rel="stylesheet" href="~/styles/pages/explore.css" />
}

<main>
    <section class="hero-container">
        <section class="hero-content">
            <span class="subtitle">Vista do Paraíso</span>
            <h1>Um hotel para cada momento rico</h1>
            <p>Cada momento parece como se fosse a primeira vez.</p>

            <div class="hero-actions">
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary">Reserve agora</a>
                <a href="#tour-section" class="btn-tour">
                    <span class="play-icon"><i class="fa-solid fa-play"></i></span>
                    Faça um Tour
                </a>
            </div>
        </section>

        <section class="hero-image">
            <img src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=1200&q=80" alt="Vista do Paraíso Resort">
        </section>
    </section>

    <section class="facilities-container">
        <h2>Nossas Instalações</h2>
        <p>Oferecemos instalações modernas de hotel 5 estrelas para o seu conforto.</p>
    </section>

    <section class="explore-container">
        <!-- HEADER -->
        <section class="explore-header">
            <div class="header-content">
                <span id="tour-section">Vista do Paraíso</span>

                <h1>Explore Experiências de Luxo</h1>
                <p>Descubra experiências exclusivas, acomodações premium e momentos inesquecíveis pensados para o seu conforto.</p>
            </div>
        </section>

        <!-- CONTENT -->
        <section class="explore-content">
            <div class="section-title">
                <h2>Explore Nossas Experiências</h2>
                <p>Vista do Paraíso oferece serviços de luxo e experiências deslumbrantes para cada hóspede.</p>
            </div>

            <!-- FEATURES -->
            <div class="features">
                <div class="feature-box">
                    <div class="feature-icon">
                        <i class="fa-solid fa-spa"></i>
                    </div>

                    <h3>Spa & Bem-Estar</h3>
                    <p>Relaxe com tratamentos de spa premium e experiências de bem-estar.</p>
                </div>

                <div class="feature-box">
                    <div class="feature-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>

                    <h3>Centro de Fitness</h3>
                    <p>Equipamentos de academia modernos disponíveis 24 horas para todos os hóspedes.</p>
                </div>

                <div class="feature-box">
                    <div class="feature-icon">
                        <i class="fa-solid fa-water-ladder"></i>
                    </div>

                    <h3>Piscina Privativa</h3>
                    <p>Áreas exclusivas de piscina privativa com serviço de luxo e conforto.</p>
                </div>

                <div class="feature-box">
                    <div class="feature-icon">
                        <i class="fa-solid fa-champagne-glasses"></i>
                    </div>

                    <h3>Eventos de Luxo</h3>
                    <p>Celebre momentos inesquecíveis com experiências elegantes de eventos.</p>
                </div>
            </div>
        </section>
    </section>
</main>
