@{
    // Essa página serve como um espaço para que o usuário
    // possa entrar em contato com o hotel, seja para tirar
    // dúvidas, solicitar informações ou fazer reservas.

    ViewData["Title"] = "Contate-nos";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/contact.css" />
}

<main class="contact-container">
    <!-- LEFT -->
    <section class="contact-left">
        <div class="contact-overlay">
            <h1>Entre em Contato</h1>
            <p>Nós estamos aqui para ajudar você a criar momentos inesquecíveis com o nosso hotel.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="contact-right">
        <a asp-controller="Home" asp-action="Index" class="back-button"><i class="fa-solid fa-arrow-left"></i> Voltar</a>

        <div class="contact-box">
            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">Vista do Paraíso</span>

            <h2>Contate-Nos</h2>
            <p>Envie-nos uma mensagem e nossa equipe entrará em contato com você em breve.</p>

            <form onsubmit="event.preventDefault(); alert('Mensagem enviada com sucesso!')">
                <div class="input-group">
                    <label>Nome</label>

                    <div class="input-box">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" placeholder="Digite seu nome" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>E-mail</label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>
                        <input type="email" placeholder="Digite seu e-mail" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>Mensagem</label>

                    <div class="input-box">
                        <i class="fa-solid fa-message"></i>
                        <textarea placeholder="Digite sua mensagem" required></textarea>
                    </div>
                </div>

                <button class="btn-contact">Enviar Mensagem</button>
            </form>

            <div class="contact-info">
                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div class="info-text">
                        <h4>Telefone</h4>
                        <span>+55 (31) 99999-9999</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div class="info-text">
                        <h4>E-Mail</h4>
                        <span>contact@paradiseview.com</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div class="info-text">
                        <h4>Localização</h4>
                        <span>Belo Horizonte, Brasil</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
