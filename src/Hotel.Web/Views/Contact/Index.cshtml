@{
    ViewData["Title"] = "Contact Us";
    ViewData["HasHeader"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/styles/pages/contact.css" />
}

<main class="contact-container">
    <!-- LEFT -->
    <section class="contact-left">
        <div class="contact-overlay">
            <h1>Get In Touch</h1>
            <p>We are here to help you create unforgettable moments at Paradise View Hotel.</p>
        </div>
    </section>

    <!-- RIGHT -->
    <section class="contact-right">
        <a href="index.html" class="back-button"><i class="fa-solid fa-arrow-left"></i> Back</a>

        <div class="contact-box">
            <div class="logo">
                <span style="color:#84724E;">▲</span>
                <span>PV</span>
            </div>

            <span class="subtitle">Paradise View</span>

            <h2>Contact Us</h2>
            <p>Send us a message and our team will contact you shortly.</p>

            <form onsubmit="event.preventDefault(); alert('Mensagem enviada com sucesso!')">
                <div class="input-group">
                    <label>Nome</label>

                    <div class="input-box">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" placeholder="Digite seu nome" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>E-mail</label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>
                        <input type="email" placeholder="Digite seu e-mail" required>
                    </div>
                </div>

                <div class="input-group">
                    <label>Mensagem</label>

                    <div class="input-box">
                        <i class="fa-solid fa-message"></i>
                        <textarea placeholder="Digite sua mensagem" required></textarea>
                    </div>
                </div>

                <button class="btn-contact">Enviar Mensagem</button>
            </form>

            <div class="contact-info">
                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div class="info-text">
                        <h4>Telefone</h4>
                        <span>+55 (31) 99999-9999</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div class="info-text">
                        <h4>E-mail</h4>
                        <span>contact@paradiseview.com</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div class="info-text">
                        <h4>Localização</h4>
                        <span>Belo Horizonte, Brasil</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
